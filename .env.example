# =====================================================================
# .env.example - Các biến môi trường của Discord Cybersecurity News Bot
#
# CÁCH DÙNG:
# - LOCAL  : copy file này thành ".env" rồi điền giá trị (KHÔNG commit .env).
# - CI     : khai báo trong GitHub Settings > Secrets and variables > Actions
#            (Settings > Secrets > Actions > New repository secret).
#
# BẢO MẬT:
# - TUYỆT ĐỐI KHÔNG commit file .env thật vào git.
#   (đảm bảo .gitignore có dòng:  .env)
# - KHÔNG hard-code token/API key vào code.
# - KHÔNG ghi token/key vào state hay log.
# =====================================================================

# ---------------------------------------------------------------------
# 1. BẮT BUỘC - DISCORD
# ---------------------------------------------------------------------

# Discord Bot Token (Discord Developer Portal > Bot > Reset Token).
# GitHub Actions đọc từ Secrets có tên DISCORD_BOT_TOKEN.
DISCORD_BOT_TOKEN=

# ---------------------------------------------------------------------
# 2. TÙY CHỌN CHẠY (không bắt buộc)
# ---------------------------------------------------------------------

# "1" = chạy thử, KHÔNG đăng thật, chỉ in nội dung ra log (dùng khi debug).
DRY_RUN=0

# Mức log: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Đường dẫn file state (mặc định: state/news_state.json)
STATE_FILE=state/news_state.json

# ---------------------------------------------------------------------
# 2b. TIN NÓNG (HOT NEWS) - tùy chọn, KHÔNG bắt buộc
# ---------------------------------------------------------------------
# Chuỗi RỖNG (để trống) ở mọi biến dưới đây = dùng MẶC ĐỊNH của config.py.

# HOT_ENABLED : BẬT/TẮT hẳn tính năng tin nóng (quota riêng 2 nóng + 2 thường/ngày).
#   "1" = bật (mặc định), "0" / "false" / "off" / "no" = tắt hẳn.
#   Để trống -> dùng mặc định = 1 (BẬT).
HOT_ENABLED=1

# HOT_ALLOW_WITHOUT_AI : có cho đăng tin nóng khi KHÔNG có AI (AI tắt/lỗi) không?
#   "0" = KHÔNG (mặc định - không AI thì không đăng tin nóng).
#   "1" = CÓ, khi đó bài nóng bắt buộc có >= 3 nguồn RSS độc lập mới đăng.
#   Để trống -> dùng mặc định = 0 (TẮT).
HOT_ALLOW_WITHOUT_AI=0

# ---------------------------------------------------------------------
# 3. AI (tùy chọn - KHÔNG bắt buộc, miễn phí hay không tùy provider)
# ---------------------------------------------------------------------
# Bot chạy TỐT cả khi phần này để trống: khi đó bot dùng rule-based thuần
# (analyzer.py) và KHÔNG gọi API AI nào.
#
# AI_PROVIDER : "openai" | "groq" | "openrouter" | "ollama" | "custom"
#               Để TRỐNG (hoặc "off"/"none") = TẮT AI.
#
# Các biến AI chỉ cần set khi BẬT AI. Không có key -> AI tự tắt, bot vẫn chạy.
#
# Ghi chú free tier (PHẢI tự kiểm tra điều khoản mới nhất trước khi dùng):
# - groq       : https://www.groq.com        - CÓ free tier (rate limit).
# - openrouter : https://openrouter.ai       - một số model ":free".
# - ollama     : chạy local                  - MIỄN PHÍ hoàn toàn
#                (chỉ dùng khi chạy máy cá nhân, KHÔNG có trên GitHub Actions).
# - openai     : https://platform.openai.com - THƯỜNG PHẢI TRẢ TIỀN.
#               Không phải mọi provider đều miễn phí; hãy tự xác nhận.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# AI_BASE_URL: chỉ set khi muốn đổi endpoint (OpenAI-compatible
# /chat/completions). Để trống -> dùng endpoint mặc định của provider.
AI_BASE_URL=

# Timeout (giây) cho mỗi lời gọi AI, mặc định 45 (tối đa 120).
AI_TIMEOUT_SECONDS=45

# Số bài tối đa (từ analyzer) gửi cho AI đánh giá trong 1 lần chạy,
# mặc định 6 (tối đa 20). Quota đăng/ngày vẫn là MAX_POSTS_PER_DAY = 2
# do code quyết định, AI KHÔNG thể đổi.
AI_MAX_CANDIDATES=6

# ---------------------------------------------------------------------
# VÍ DỤ BẬT AI (miễn phí, ví dụ Groq free tier):
#
#   AI_PROVIDER=groq
#   AI_API_KEY=gsk_xxxxxxxxxxxxxxxx
#   AI_MODEL=llama-3.3-70b-versatile
#
# Ví dụ tắt AI (rule-based thuần):
#
#   AI_PROVIDER=
# ---------------------------------------------------------------------
